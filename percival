#!/usr/bin/env bash
#
# percival — bug-bounty recon framework. One command, every phase, program-aware.
#
#   percival new [program]        onboarding: scope, identification, rules (asked once)
#   percival recon [program]      full recon pipeline
#   percival ports [program]      active port scan on the declared in-scope IP ranges (if allowed)
#   percival shodan [program]     passive Shodan InternetDB over the collected IPs (no traffic)
#   percival wayback [program]    historical URLs from public archives (OSINT, no traffic)
#   percival secrets [program]    GitHub leak hunting (OSINT, no traffic)
#   percival triage [program]     offline triage of the catch into leads (no traffic)
#   percival db <sub>             per-program store: recall any host, IP or path with all you found
#   percival report [program]     build one HTML report from the data you have
#   percival export [program]     export the scope to Burp / Caido (no traffic)
#   percival replay [program]     re-send the discovered surface (live hosts) through Burp/Caido
#   percival snapshot [program]   visual preview: screenshot the live pages into a gallery
#   percival status [program]     what the run produced, leads first
#   percival verify [program]     scope QA: nothing out of scope touched
#   percival retest [program]     only what is new since the last scan
#   percival schedule [program]   run retest automatically on a schedule (systemd/cron)
#   percival backup [program]     archive the program folder (data, db, report) into one .tar.gz
#   percival info [program]       program settings and scope summary
#   percival scope [program]      view / edit the scope
#   percival ls                   all programs
#   percival doctor [--install]   is this machine ready
#
# The program can be omitted: percival uses the last one you worked on.
set -euo pipefail

PERCIVAL_VERSION="0.2.1"

# resolve our real location (works through symlinks, e.g. ~/.local/bin/percival)
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
PERCIVAL_ROOT="$(cd -P "$(dirname "$_src")" && pwd)"
export PERCIVAL_ROOT

# shellcheck source=lib/ui.sh
. "$PERCIVAL_ROOT/lib/ui.sh"
# shellcheck source=lib/core.sh
. "$PERCIVAL_ROOT/lib/core.sh"
for _f in "$PERCIVAL_ROOT"/cmd/*.sh; do
  # shellcheck disable=SC1090
  . "$_f"
done

usage() {
  ui_banner "$PERCIVAL_VERSION"
  sed -n '5,26p' "$PERCIVAL_ROOT/percival" | sed 's/^# \{0,1\}//' >&2
  printf '\n  percival <command> --help for details\n\n' >&2
}

# engine <script> <program> [args...] — run an engine script on a program
engine() {
  local script="$1" prog="$2"; shift 2
  prog="$(resolve_program "$prog")"
  load_program "$prog"
  bash "$PERCIVAL_ROOT/libexec/$script" "$@"
}

# split "[program] [args]": the first arg is the program unless it starts with '-'
dispatch() {
  local cmd="${1:-}"; shift || true
  local prog=""
  if [ $# -gt 0 ] && [[ "$1" != -* ]]; then prog="$1"; shift; fi
  case "$cmd" in
    new)              cmd_new ${prog:+"$prog"} "$@" ;;
    scope)            cmd_scope ${prog:+"$prog"} "$@" ;;
    info)             cmd_info ${prog:+"$prog"} "$@" ;;
    report)           cmd_report ${prog:+"$prog"} "$@" ;;
    export)           cmd_export ${prog:+"$prog"} "$@" ;;
    replay)           cmd_replay ${prog:+"$prog"} "$@" ;;
    snapshot|shot)    cmd_snapshot ${prog:+"$prog"} "$@" ;;
    schedule|sched)   cmd_schedule ${prog:+"$prog"} "$@" ;;
    backup)           cmd_backup ${prog:+"$prog"} "$@" ;;
    ls|list)          cmd_ls ;;
    doctor)           cmd_doctor ${prog:+"$prog"} "$@" ;;
    recon)            cmd_recon ${prog:+"$prog"} "$@" ;;
    status)           cmd_status ${prog:+"$prog"} "$@" ;;
    verify)           cmd_verify ${prog:+"$prog"} "$@" ;;
    ports)            cmd_ports ${prog:+"$prog"} "$@" ;;
    shodan)           cmd_shodan ${prog:+"$prog"} "$@" ;;
    wayback)          cmd_wayback ${prog:+"$prog"} "$@" ;;
    retest)           cmd_retest ${prog:+"$prog"} "$@" ;;
    secrets)          cmd_secrets ${prog:+"$prog"} "$@" ;;
    triage|loot)      cmd_triage ${prog:+"$prog"} "$@" ;;
    db)               cmd_db ${prog:+"$prog"} "$@" ;;
    version|--version|-V) printf 'percival %s\n' "$PERCIVAL_VERSION" ;;
    ""|help|-h|--help) usage ;;
    *) ui_die "unknown command '$cmd'" "percival help" ;;
  esac
}

dispatch "$@"
